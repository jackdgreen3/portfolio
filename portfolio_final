    <title>Jack Green - Data Science & Stories</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        :root {
            --primary: #2d5016;
            --accent: #e8704a;
            --light-bg: #fffaf0;
            --card-bg: #fff5e6;
            --text: #3d3d3d;
            --text-light: #6b6b6b;
        }
        body {
            font-family: 'Georgia', 'Times New Roman', serif;
            background: linear-gradient(to bottom, var(--light-bg), #fff9f0);
            color: var(--text);
            line-height: 1.8;
        }
        header {
            background: linear-gradient(135deg, var(--primary) 0%, #3d6b1f 100%);
            color: white;
            padding: 80px 40px;
            text-align: center;
            border-bottom: 5px solid var(--accent);
        }
        header h1 {
            font-size: 3.2em;
            margin-bottom: 15px;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .welcome {
            font-size: 1.3em;
            font-style: italic;
            margin-bottom: 20px;
            color: #f0f0f0;
            font-weight: 300;
        }
        .intro-text {
            font-size: 1.05em;
            max-width: 700px;
            margin: 0 auto 25px;
            line-height: 1.7;
            color: #e8e8e8;
        }
        .cta-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }
        .cta-btn {
            background: var(--accent);
            color: white;
            padding: 12px 30px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 0.95em;
        }
        .cta-btn:hover {
            background: #d45a33;
            transform: scale(1.05);
        }
        .cta-btn.secondary {
            background: transparent;
            border: 2px solid white;
            color: white;
        }
        .cta-btn.secondary:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        nav {
            position: sticky;
            top: 0;
            background: white;
            border-bottom: 2px solid var(--accent);
            padding: 15px 40px;
            display: flex;
            justify-content: center;
            gap: 35px;
            z-index: 100;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
        }
        nav a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95em;
            transition: color 0.3s ease;
        }
        nav a:hover {
            color: var(--accent);
        }
        .container {
            max-width: 950px;
            margin: 0 auto;
            padding: 60px 40px;
        }
        section {
            margin-bottom: 70px;
        }
        h2 {
            font-size: 2.2em;
            color: var(--primary);
            margin-bottom: 30px;
            position: relative;
            padding-bottom: 15px;
        }
        h2::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 4px;
            background: var(--accent);
            border-radius: 2px;
        }
        .intro-paragraph {
            font-size: 1.05em;
            color: var(--text);
            line-height: 1.9;
            margin-bottom: 25px;
        }
        .project-card {
            background: var(--card-bg);
            padding: 35px;
            margin-bottom: 25px;
            border-radius: 8px;
            border-left: 5px solid var(--accent);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }
        .project-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(232, 112, 74, 0.12);
        }
        .project-card h3 {
            color: var(--primary);
            font-size: 1.35em;
            margin-bottom: 8px;
        }
        .project-meta {
            color: var(--text-light);
            font-size: 0.9em;
            margin-bottom: 15px;
            font-style: italic;
        }
        .project-card p {
            color: var(--text);
            line-height: 1.8;
        }
        .highlight {
            color: var(--accent);
            font-weight: 600;
        }
        .skills-showcase {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }
        .skill-tag {
            background: white;
            border: 2px solid var(--accent);
            color: var(--primary);
            padding: 12px 18px;
            border-radius: 25px;
            text-align: center;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .skill-tag:hover {
            background: var(--accent);
            color: white;
        }
        .education-card {
            background: var(--card-bg);
            padding: 28px;
            margin-bottom: 20px;
            border-radius: 8px;
            border-top: 4px solid var(--accent);
        }
        .education-card h3 {
            color: var(--primary);
            font-size: 1.15em;
            margin-bottom: 8px;
        }
        .education-card .school {
            color: var(--text-light);
            font-weight: 600;
            margin-bottom: 5px;
        }
        .education-card .details {
            color: var(--text-light);
            font-size: 0.95em;
            line-height: 1.6;
        }
        .awards-section {
            background: linear-gradient(135deg, #f5e6d3 0%, #ffecd2 100%);
            padding: 30px;
            border-radius: 8px;
            margin-top: 20px;
        }
        .awards-section h4 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 1.05em;
        }
        .awards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }
        .award {
            color: var(--text);
            font-size: 0.95em;
            line-height: 1.6;
        }
        footer {
            background: linear-gradient(135deg, var(--primary) 0%, #3d6b1f 100%);
            color: white;
            padding: 50px 40px;
            text-align: center;
            margin-top: 60px;
        }
        footer p {
            margin-bottom: 10px;
            line-height: 1.6;
        }
        .footer-note {
            font-size: 0.9em;
            opacity: 0.9;
            margin-top: 20px;
        }
        @media (max-width: 768px) {
            header h1 {
                font-size: 2.2em;
            }
            .welcome {
                font-size: 1.05em;
            }
            nav {
                gap: 15px;
                padding: 10px 20px;
            }
            .container {
                padding: 40px 20px;
            }
            .cta-buttons {
                gap: 10px;
            }
            .cta-btn {
                padding: 10px 20px;
                font-size: 0.9em;
            }
        }
    </style>
</head>
